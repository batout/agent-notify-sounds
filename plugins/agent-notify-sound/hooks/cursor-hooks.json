{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "bash ./scripts/mark.sh --host cursor"
      }
    ],
    "stop": [
      {
        "command": "bash ./scripts/play.sh --host cursor done"
      }
    ],
    "subagentStop": [
      {
        "command": "bash ./scripts/play.sh --host cursor subagent"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash ./scripts/play.sh --host cursor attention"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "bash ./scripts/play.sh --host cursor attention"
      }
    ]
  }
}
