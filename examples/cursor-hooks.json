{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "bash \"/path/to/agent-notify-sounds/plugins/agent-notify-sound/scripts/mark.sh\" --host cursor"
      }
    ],
    "stop": [
      {
        "command": "bash \"/path/to/agent-notify-sounds/plugins/agent-notify-sound/scripts/play.sh\" --host cursor done"
      }
    ],
    "subagentStop": [
      {
        "command": "bash \"/path/to/agent-notify-sounds/plugins/agent-notify-sound/scripts/play.sh\" --host cursor subagent"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash \"/path/to/agent-notify-sounds/plugins/agent-notify-sound/scripts/play.sh\" --host cursor attention"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "bash \"/path/to/agent-notify-sounds/plugins/agent-notify-sound/scripts/play.sh\" --host cursor attention"
      }
    ]
  }
}
